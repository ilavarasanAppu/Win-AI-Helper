{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Agent Executable Workflow — Plan Script Logic",
  "description": "Schema for PART 2 logic.json generated by Plan mode. Every plan must emit JSON validating against this schema.",
  "type": "object",
  "required": ["meta", "workflow", "files"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["objective", "version"],
      "properties": {
        "objective": { "type": "string", "description": "Restated objective from PART 1" },
        "version": { "type": "string", "example": "1.0" },
        "author": { "type": "string" },
        "created": { "type": "string", "format": "date" }
      }
    },
    "workflow": {
      "type": "array",
      "description": "Ordered executable steps. Agent executes sequentially respecting depends_on.",
      "items": {
        "type": "object",
        "required": ["step", "id", "action", "input", "output", "tool", "depends_on"],
        "properties": {
          "step": { "type": "integer", "description": "1-indexed order" },
          "id": { "type": "string", "description": "Slug id, e.g., setup, scrape, render" },
          "action": { "type": "string", "description": "What to do, imperative" },
          "input": { "type": "string", "description": "Required input for this step" },
          "output": { "type": "string", "description": "Expected output/artifact" },
          "tool": { "type": "string", "enum": ["bash", "python", "ollama", "api", "manual", "file"], "description": "Tool/agent capability needed" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "description": "List of step ids that must complete first" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "code_block": { "type": "string", "description": "Optional code/pseudocode for this step. Empty if manual." },
          "validation": { "type": "string", "description": "How to verify step succeeded" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string", "example": "src/main.py" },
          "purpose": { "type": "string" },
          "template": { "type": "string", "enum": ["python", "json", "markdown", "yaml", "bash", "text"] }
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Environment variables / config",
      "additionalProperties": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "example": {
    "meta": {
      "objective": "Scrape NSE stock price and generate intraday signal",
      "version": "1.0"
    },
    "workflow": [
      {
        "step": 1,
        "id": "setup",
        "action": "Create project folder and install dependencies",
        "input": "objective",
        "output": "project structure + requirements",
        "tool": "bash",
        "depends_on": [],
        "priority": "P0",
        "code_block": "mkdir nse-scraper && cd nse-scraper && pip install requests",
        "validation": "Folder exists and requirements installed"
      },
      {
        "step": 2,
        "id": "fetch_price",
        "action": "Fetch live price from NSE API",
        "input": "stock symbol",
        "output": "price JSON",
        "tool": "python",
        "depends_on": ["setup"],
        "priority": "P0",
        "code_block": "import requests\nresp = requests.get(f'https://www.nseindia.com/api/quote-equity?symbol={symbol}')\nprint(resp.json())",
        "validation": "price field present in response"
      },
      {
        "step": 3,
        "id": "analyze",
        "action": "Analyze trend, support/resistance, volume",
        "input": "price JSON",
        "output": "signal (BUY/SELL/NO TRADE)",
        "tool": "python",
        "depends_on": ["fetch_price"],
        "priority": "P0",
        "code_block": "# compute SMA, RSI, volume check\nif rsi < 30 and volume > avg: signal='BUY'",
        "validation": "signal is one of BUY/SELL/NO TRADE"
      }
    ],
    "files": [
      { "path": "main.py", "purpose": "Main scraper + analyzer", "template": "python" },
      { "path": "config.json", "purpose": "Symbols and thresholds", "template": "json" }
    ],
    "env": {
      "python_version": "3.10",
      "nse_api": "https://www.nseindia.com/api/quote-equity"
    },
    "acceptance_criteria": [
      "Live price fetched successfully",
      "Signal generated with Entry/SL/Target",
      "No hardcoded secrets"
    ]
  }
}
